#!/usr/bin/env bash
# Refuse to commit anything over 5 MB.
#
# ITCH session files are multi-gigabyte and GitHub hard-rejects any push
# containing a blob over 100 MB. By the time the push fails, the blob is already
# in local history and removing it means rewriting every commit after it.
set -euo pipefail

limit_bytes=$((5 * 1024 * 1024))
oversized=""

while IFS= read -r path; do
    [ -f "$path" ] || continue
    size=$(stat -c%s "$path")
    if [ "$size" -gt "$limit_bytes" ]; then
        oversized+="  ${path} ($((size / 1024 / 1024)) MB)"$'\n'
    fi
done < <(git diff --cached --name-only --diff-filter=ACM)

if [ -n "$oversized" ]; then
    printf 'pre-commit: refusing to commit files over 5 MB:\n%s' "$oversized" >&2
    printf 'If this is deliberate, use --no-verify.\n' >&2
    exit 1
fi